# PortCraft Environment Variables
# Copy this to .env.local and fill in your values

# Required for AI features (portfolio generation, chatbot, content improvement)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Override the default Gemini model
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Optional: GitHub personal access token for higher API rate limits (5000/hr vs 60/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
